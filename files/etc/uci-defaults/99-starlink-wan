#!/bin/sh
# First-boot WAN defaults for the field kit: Starlink on jack2, aux on jack1.
#
# The two USB NICs get stable, jack-pinned names from the hotplug rename
# script (05-usbnic-name): jack1/jack2, keyed on USB controller position —
# label the physical jacks to match. The dish is always cabled to jack2 on
# this hardware, so WAN is fixed there; jack1 is the 'aux' interface, free
# for unrelated equipment (configure any proto/addressing it needs on aux).
#
# The dish itself (192.168.100.1: web UI and gRPC API on :9200) is reached
# through the WAN lease — Starlink's DHCP pushes a route to it — so there is
# no static alias in the dish subnet; nothing on the router can talk to the
# dish until it has handed out a lease.
uci -q batch <<'EOF'
delete network.br_wan
set network.wan=interface
set network.wan.device='jack2'
set network.wan.proto='dhcp'
set network.wan6=interface
set network.wan6.device='jack2'
set network.wan6.proto='dhcpv6'
delete network.starlink_dish
delete network.dishmgmt
set network.aux=interface
set network.aux.device='jack1'
set network.aux.proto='none'
commit network
EOF
exit 0
