#!/bin/sh /etc/rc.common
# Keeps WAN on whichever USB port the Starlink dish is actually plugged
# into (see /usr/sbin/starlink-portd). Started via a shipped rc.d symlink
# so it runs from the very first boot.
START=25
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/starlink-portd
    procd_set_param respawn
    procd_close_instance
}
